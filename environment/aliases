export SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
export XDCTOOLS_JAVA_HOME="${XDCTOOLS_JAVA_HOME:-/usr/lib/jvm/default-java}"
export DOCKER_WORKINGDIR="/workspace"
export DOCKER_IMAGE_NAME="cc2640r2f_ble"

alias build_docker="docker build --network=host -t \"$DOCKER_IMAGE_NAME\" \"$SCRIPT_DIR\""
alias run_docker="docker run --rm -it --net=host -v \"$SCRIPT_DIR\"/..:\"$DOCKER_WORKINGDIR\" -v /etc/passwd:/etc/passwd:ro -v /etc/group:/etc/group:ro -u $(id -u ${USER}):$(id -g ${USER}) --entrypoint=/bin/bash \"$DOCKER_IMAGE_NAME\""
alias run_docker_as_root="docker run --rm -it --net=host -v \"$SCRIPT_DIR\"/..:\"$DOCKER_WORKINGDIR\" --entrypoint=/bin/bash \"$DOCKER_IMAGE_NAME\""
alias rebuild_fw="docker run --rm -t --net=host -v \"$REPO_ROOT\":\"$DOCKER_WORKINGDIR\" --entrypoint=/bin/bash \"$DOCKER_IMAGE_NAME\" -c \"cd $DOCKER_WORKINGDIR && make rebuild-fw\""
alias clean_fw="docker run --rm -t --net=host -v \"$REPO_ROOT\":\"$DOCKER_WORKINGDIR\" --entrypoint=/bin/bash \"$DOCKER_IMAGE_NAME\" -c \"cd $DOCKER_WORKINGDIR && make clean-fw\""
alias diagnose_fw="docker run --rm -t --net=host -v \"$REPO_ROOT\":\"$DOCKER_WORKINGDIR\" --entrypoint=/bin/bash \"$DOCKER_IMAGE_NAME\" -c \"cd $DOCKER_WORKINGDIR && make diagnose-fw-xdc\""
alias rebuild_fw_wsl="make -C \"$REPO_ROOT\" rebuild-fw"
alias clean_fw_wsl="make -C \"$REPO_ROOT\" clean-fw"
alias fw_paths="make -C \"$REPO_ROOT\" show-paths"
