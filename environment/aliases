export XDCTOOLS_JAVA_HOME="/usr/lib/jvm/default-java"
export CCS_PATH="/workspace/thirdparty/ti_cc2640r2f_sdk/ccs1281"
export TI_SDK_PATH="/workspace/thirdparty/ti_cc2640r2f_sdk/simplelink_cc2640r2_sdk_5_30_01_11"
export APP_PATH="/workspace/firmware/ble5_simple_peripheral_cc2640r2lp_app"
export STACK_LIBRARY_PATH="/workspace/firmware/ble5_simple_peripheral_cc2640r2lp_stack_library"


export DOCKER_WORKINGDIR="/workspace"
export SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export DOCKER_IMAGE_NAME="cc2640r2f_ble"

alias build_docker="docker build --network=host -t \"$DOCKER_IMAGE_NAME\" \"$SCRIPT_DIR\""
alias run_docker="docker run --rm -it --net=host -v \"$SCRIPT_DIR\"/..:\"$DOCKER_WORKINGDIR\" -v /etc/passwd:/etc/passwd:ro -v /etc/group:/etc/group:ro -u $(id -u ${USER}):$(id -g ${USER}) --entrypoint=/bin/bash \"$DOCKER_IMAGE_NAME\""
alias run_docker_as_root="docker run --rm -it --net=host -v \"$SCRIPT_DIR\"/..:\"$DOCKER_WORKINGDIR\" --entrypoint=/bin/bash \"$DOCKER_IMAGE_NAME\""
alias rebuild_fw="docker run --rm -t --net=host -v \"$SCRIPT_DIR\"/..:\"$DOCKER_WORKINGDIR\" --entrypoint=/bin/bash \"$DOCKER_IMAGE_NAME\" -c \"cd $DOCKER_WORKINGDIR && source environment/aliases && cd firmware/ble5_simple_peripheral_cc2640r2lp_app && make -C ./FlashROM_StackLibrary/ clean && make -C ./FlashROM_StackLibrary/ all\""
alias clean_fw="docker run --rm -t --net=host -v \"$SCRIPT_DIR\"/..:\"$DOCKER_WORKINGDIR\" --entrypoint=/bin/bash \"$DOCKER_IMAGE_NAME\" -c \"cd $DOCKER_WORKINGDIR && source environment/aliases && cd firmware/ble5_simple_peripheral_cc2640r2lp_app && make -C ./FlashROM_StackLibrary/ clean\""
