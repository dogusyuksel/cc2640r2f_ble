# Firmware build outputs
firmware/app/build/*
!firmware/app/build/
!firmware/app/build/makefile
firmware/app/config/src/
firmware/stack/build/*
!firmware/stack/build/
!firmware/stack/build/makefile

# custom ignores
*.d_raw
ccsObjs.opt
*.ccsproject
*.vscode
.exclude

# Python local tooling
__pycache__/
.venv/

# Prerequisites
*.d

# Object files
*.o
*.ko
*.obj
*.elf
*.hex
*.mak
*.dot
*.xs

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries
*.a
*.la
*.lo

# Required vendored TI prebuilt libraries
!firmware/vendor/ti_cc2640r2/source/ti/ble5stack/blelib/cc26x0r2/**/*.a

# XDC package scripts are source inputs for TI-RTOS configuro, not build outputs.
!firmware/vendor/ti_cc2640r2/kernel/tirtos/packages/**/*.xs
!firmware/vendor/ti_cc2640r2/source/ti/drivers/rf/package.xs
!firmware/vendor/ti_cc2640r2/kernel/tirtos/packages/ti/sysbios/rom/cortexm/cc26xx/r2/golden/CC26xx/*.obj

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
*.mod*
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf
